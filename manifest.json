{
    "name": "AI Text Assistant",
    "version": "1.0",
    "manifest_version": 3,
    "description": "選択したテキストをAIで要約・翻訳します。",
    "permissions": [
      "contextMenus",
      "scripting",
      "storage"
    ],
    "host_permissions": [
      "<all_urls>"
    ],
    "background": {
      "service_worker": "background.js"
    },
    "content_scripts": [
      {
        "matches": ["<all_urls>"],
        "js": ["content_script.js"],
        "css": ["style.css"]
      }
    ],
    "icons": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  }
  
  